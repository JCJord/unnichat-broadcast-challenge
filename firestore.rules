rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for tenant authentication and ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Connections collection (Root collection - No subcollections)
    match /connections/{connectionId} {
      function isValidConnectionName(name) {
        return name is string && name.size() >= 2 && name.size() <= 50;
      }

      allow read: if isDocOwner(resource.data.userId);

      allow create: if isDocOwner(request.resource.data.userId)
        && request.resource.data.keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'name', 'createdAt', 'updatedAt'])
        && isValidConnectionName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isDocOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isValidConnectionName(request.resource.data.name)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isDocOwner(resource.data.userId);
    }

    // 2. Contacts collection (Root collection - linked via connectionId & userId)
    match /contacts/{contactId} {
      function isValidContactName(name) {
        return name is string && name.size() >= 2 && name.size() <= 60;
      }

      function isValidPhone(phone) {
        return phone is string && phone.matches('^[0-9]{10,11}$');
      }

      function isConnectionOwner(connId) {
        return get(/databases/$(database)/documents/connections/$(connId)).data.userId == request.auth.uid;
      }

      allow read: if isDocOwner(resource.data.userId);

      allow create: if isDocOwner(request.resource.data.userId)
        && request.resource.data.keys().hasAll(['userId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && request.resource.data.connectionId is string
        && isConnectionOwner(request.resource.data.connectionId)
        && isValidContactName(request.resource.data.name)
        && isValidPhone(request.resource.data.phone)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isDocOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
        && isValidContactName(request.resource.data.name)
        && isValidPhone(request.resource.data.phone)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isDocOwner(resource.data.userId);
    }

    // 3. Broadcasts collection (Root collection - linked via connectionId & userId)
    match /broadcasts/{broadcastId} {
      function isValidMessage(msg) {
        return msg is string && msg.size() >= 1 && msg.size() <= 1000;
      }

      function isConnectionOwner(connId) {
        return get(/databases/$(database)/documents/connections/$(connId)).data.userId == request.auth.uid;
      }

      function isValidBroadcastStatus(status) {
        return status in ['scheduled', 'sent'];
      }

      allow read: if isDocOwner(resource.data.userId);

      allow create: if isDocOwner(request.resource.data.userId)
        && request.resource.data.keys().hasAll([
          'userId', 'connectionId', 'contactIds', 'recipientCount', 
          'message', 'status', 'scheduledFor', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'connectionId', 'contactIds', 'recipientCount', 
          'message', 'status', 'scheduledFor', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.connectionId is string
        && isConnectionOwner(request.resource.data.connectionId)
        && isValidMessage(request.resource.data.message)
        && request.resource.data.contactIds is list
        && request.resource.data.contactIds.size() > 0
        && request.resource.data.recipientCount is int
        && request.resource.data.recipientCount == request.resource.data.contactIds.size()
        && isValidBroadcastStatus(request.resource.data.status)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isDocOwner(resource.data.userId)
        && resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'message', 'contactIds', 'recipientCount', 'scheduledFor', 'status', 'sentAt', 'updatedAt'
        ])
        && isValidMessage(request.resource.data.message)
        && request.resource.data.contactIds is list
        && request.resource.data.contactIds.size() > 0
        && request.resource.data.recipientCount is int
        && request.resource.data.recipientCount == request.resource.data.contactIds.size()
        && request.resource.data.updatedAt == request.time;

      allow delete: if isDocOwner(resource.data.userId);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
